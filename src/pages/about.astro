---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero2 from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Steps3 from '~/components/widgets/Steps3.astro';
import Layout from '~/layouts/PageLayout.astro';
import shsLogo from '~/assets/images/shs-logo.png';
import innosuisseLogo from '~/assets/images/innosuisse-logo.png';

const metadata = {
  title: 'About us',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero2
  tagline=""

>
<Fragment slot="title">
  Digital solutions. HealthTech. <br />
  <span class="text-accent dark:text-white highlight">Swiss</span> made.<br />
</Fragment>
<br><br>
<Fragment slot="subtitle">
  <span><br><br>
    Digital transformation should be simple and straightforward.<br><br>

    This belief was the founding principle of Setbase — and it remains one of our core values today.<br><br>

    Founded in 2024 by a team of experienced IT professionals passionate about technology and innovation, Setbase began by delivering tailored solutions to clients in the HealthTech and broader medical sectors.<br><br>

    Today, we’re focused on developing our own digital product as we strive to innovate the field of medication adherence. Our goal is to offer a valuable tool for patients and a powerful platform for partners — enabling smarter medication management and ultimately, healthier and happier lives.<br><br>

    At <span class="font-semibold">Setbase</span>, we foster a “everything can be done” mindset and believe in building long-term, trust-based partnerships with our customers and suppliers.
  </span>
      

</Fragment>

</Hero2>

<!-- Partner Section Fully Centered ************** -->
<section class="w-full border-y-2 py-16 px-6 md:px-20 bg-white dark:bg-gray-900">
  <div class="max-w-5xl mx-auto flex flex-col items-center text-center gap-10">

    <!-- Text Block -->
    <div class="max-w-xl">
      <h2 class="text-3xl font-bold mb-4 dark:text-white">Recognised and supported</h2>
      <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
        We’re proud to be supported and featured by leading Swiss innovation and startup networks.
        <br /><br />
        These partnerships empower us to grow, connect, and stay at the forefront of digital transformation in healthcare.
      </p>
    </div>

    <!-- Logos Block -->
    <div class="flex flex-col md:flex-row justify-center items-center gap-10">
      <a
        href="https://cortex.swisshealthcarestartups.com/setbase-gmbh"
        class="flex items-center justify-center border-2 p-6 border-transparent hover:border-gray-200 rounded-2xl transition-all duration-300"
        target="_blank" rel="noopener noreferrer"
      >
        <img
          src={shsLogo.src}
          alt="Swiss Healthcare Startups logo"
          class="h-auto max-w-[300px] dark:invert"
          loading="lazy"
        />
      </a>

      <a
        href="https://www.innosuisse.admin.ch/de"
        class="flex items-center justify-center border-2 p-6 border-transparent hover:border-gray-200 rounded-2xl transition-all duration-300"
        target="_blank" rel="noopener noreferrer"
      >
        <img
          src={innosuisseLogo.src}
          alt="Innosuisse - Swiss Innovation Agency logo"
          class="h-auto max-w-[300px] dark:invert"
          loading="lazy"
        />
      </a>
    </div>

  </div>
</section>

  <!-- Features3 Widget ************** -->

  <!-- Steps2 Widget ****************** -->

  <Steps2
  title="Our values"
  subtitle="We stand strong to our values and we foster and appreciate good relations with our customers and partners."
  items={[
    {
      title: 'Customer-centric approach',
      description:
        'We prioritize our customers in every decision, ensuring their needs, challenges, and goals are at the heart of our solutions.',
    },
    {
      title: 'Constant Improvement',
      description:
        'We embrace a culture of learning and adaptation, continuously refining our processes, technologies, and services to deliver the best results.',
    },
    {
      title: 'Simplicity',
      description:
        'We value clarity and efficiency, delivering solutions that are straightforward, easy to use, and focused on achieving meaningful outcomes.',
    },
    {
      title: 'True Value',
      description:
        'We focus on bringing true value even if it means changing direction or starting from scratch, we embrace what brings true value.',
    },
  ]}
/>


  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Resources"
    subtitle=""
    isReversed={true}
    items={[
      {
        title: 'Experts',
        description:
          'Setbase has an extensive network of specialists ranging from software engineers, professional consultants, data scientists, agile experts, and researchers to medical practitioners and product designers.',
        icon: 'tabler:award',
      },
      {
        title: 'In-house Lab',
        description:
          'Our well-equipped in-house lab enables us to build, simulate, and test various products and developments super fast and efficiently.',
        icon: 'tabler:message-star',
      },
    ]}
/>

  <!-- Features2 Widget ************** -->

  <Features2
    title="Our location"
    tagline="Find us"
    columns={1}
    items={[
      {
        title: 'Switzerland',
        description: 'SETBASE GmbH<br>Bachmannweg 37, 8046 Zürich <br><br>CH-ID: CH-020-4085796-5 <br><br>UID: CHE-458.377.731',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

<Steps3
  title="Get in Touch"
  subtitle="Multiple ways to contact us:"
  callToAction={{
    text: 'Reach out',
    href: '/contact',
  }}
  items={[
    {
      title: 'Email us',
      description: 'info@setbase.ch',
      icon: 'tabler:mail',
    },
    {
      title: 'Call us',
      description: '+41 78 320 72 65',
      icon: 'tabler:headset',
    },
    {
      title: 'Chat with us on WhatsApp',
      href: 'https://wa.me/41783207265',
      icon: 'tabler:phone',
    },
  ]}
  ></Steps3>
</Layout>
