---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero2 from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Steps3 from '~/components/widgets/Steps3.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Über uns',
};
---

<Layout metadata={metadata}>

  <!-- Hero Widget ******************* -->

  <Hero2 tagline="">
    <Fragment slot="title">
      Digitale Lösungen. HealthTech. <br />
      <span class="text-accent dark:text-white highlight">Swiss</span> made.<br />
    </Fragment>
    <br><br>
    <Fragment slot="subtitle">
      <span><br><br>
        Digitale Transformation sollte einfach und unkompliziert sein.<br><br>
        Dieser Leitsatz war die Gründungsidee von Setbase – und ist auch heute noch einer unserer Kernwerte.<br><br>

        Gegründet im Jahr 2024 entwickelten wir bei Setbase zunächst massgeschneiderte Lösungen für Partner im HealthTech- und Medizinbereich.<br><br>

        Heute konzentrieren wir uns auf die Entwicklung unseres eigenen digitalen Produkts, mit dem Ziel, die Medikamentenadhärenz zu verbessern.
        Unser Ziel ist es, unseren Endnutzerinnen und Endnutzer ein hilfreiches Tool und Partnern eine starke Plattform zu bieten – für ein intelligenteres Medikationsmanagement und letztlich gesündere, glücklichere Menschen.<br><br>

        Bei <span class="font-semibold">Setbase</span> leben wir eine "Alles ist machbar"-Mentalität und setzen auf langfristige, vertrauensvolle Partnerschaften mit Nutzern sowie Partnern.
      </span>
    </Fragment>
  </Hero2>

  <!-- Werte ****************** -->

  <Steps2
    title="Unsere Werte"
    subtitle="Wir stehen zu unseren Werten und schätzen gute Beziehungen."
    items={[
      {
        title: 'Kundenzentrierter Ansatz',
        description:
          'Unsere Entscheidungen orientieren sich stets an den Bedürfnissen, Herausforderungen und Zielen unserer Endnutzer.',
      },
      {
        title: 'Ständige Verbesserung',
        description:
          'Wir pflegen eine Kultur des Lernens und der Anpassung, um Prozesse, Technologien und Dienstleistungen kontinuierlich zu optimieren.',
      },
      {
        title: 'Einfachheit',
        description:
          'Wir legen Wert auf Klarheit und Effizienz und entwickeln Lösungen, die einfach, nutzerfreundlich und zielgerichtet sind. Wir pflegen einen klaren Fokus die effektive Lösung und den Nutzen.',
      },
      {
        title: 'Echter Mehrwert',
        description:
          'Wir konzentrieren uns auf das, was wirklich zählt – auch wenn das bedeutet, den Kurs zu ändern und neue Wege zu gehen.',
      },
    ]}
  />

  <!-- Ressourcen ****************** -->

  <Steps2
    title="Ressourcen"
    subtitle=""
    isReversed={true}
    items={[
      {
        title: 'Expert:innen',
        description:
          'Setbase verfügt über ein starkes Netzwerk an Spezialisten – von Softwareentwickler über Data Scientists und Produktdesignern bis hin zu praktizierenden Medizinerinnen und Pflegepersonal.',
        icon: 'tabler:award',
      },
      {
        title: 'Eigenes Labor',
        description:
          'Unser gut ausgestattetes Inhouse-Labor ermöglicht es uns, Produkte und Entwicklungen schnell und effizient zu entwickeln, zu simulieren und zu testen.',
        icon: 'tabler:message-star',
      },
    ]}
  />

  <!-- Standort ****************** -->

  <Features2
    title="Unser Standort"
    tagline="Hier finden Sie uns"
    columns={1}
    items={[
      {
        title: 'Schweiz',
        description: 'SETBASE GmbH<br>Bachmannweg 37, 8046 Zürich <br><br>CH-ID: CH-020-4085796-5 <br><br>UID: CHE-458.377.731',
      },
    ]}
  />

  <!-- Kontakt ****************** -->

  <Steps3
    title="Kontaktieren Sie uns"
    subtitle="So erreichen Sie uns:"
    callToAction={{
      text: 'Kontakt aufnehmen',
      href: '/contact',
    }}
    items={[
      {
        title: 'E-Mail',
        description: 'info@setbase.ch',
        icon: 'tabler:mail',
      },
      {
        title: 'Anrufen',
        description: '+41 78 320 72 65',
        icon: 'tabler:headset',
      },
      {
        title: 'WhatsApp Chat',
        href: 'https://wa.me/41783207265',
        icon: 'tabler:phone',
      },
    ]}
  />
</Layout>
