---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'SETBASE — HealthTech',
  ignoreTitleTemplate: true,
};

const learnmore = "Mehr erfahren";
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    actions={[
      {
        variant: 'primary', text: 'Zu Adherlo', href: 'https://www.adherlo.com', icon: 'tabler:arrow-big-right',
      },
    ]}
    image={{ src: '~/assets/images/hero-image2_AdherloBox.png', alt: 'Setbase Hero Bild mit Dashboard, App und digitaler pillenbox' }}
  >
<Fragment slot="title">
  <!-- Mobile: only "HealthTech" -->
  <span class="inline sm:hidden">
    Health<span class="text-accent dark:text-white highlight">Tech</span>
  </span>

  <!-- Desktop: "We create HealthTech" -->
  <span class="hidden sm:inline">
    Wir entwickeln Health<span class="text-accent dark:text-white highlight">Tech</span>
  </span>
</Fragment>

<Fragment slot="subtitle">
  <span>
    <br><br> Mehr über unser neuestes Projekt, <br>
    die innovative und ganzheitliche Lösung für Medikamentenmanagement und Therapietreue:
    <br><br>
  </span>
</Fragment>
</Hero>

  <!-- Features Widget *************** -->

  <Features
    id="Expertise"
    tagline="Das Startup"
    title="Was wir tun"
    subtitle={`<span class="block xl:hidden">
  In der Vergangenheit haben wir erfolgreich HealthTech-Lösungen für unsere Kunden entwickelt. Heute konzentrieren wir uns vollständig auf unser eigenes Produkt: <strong>Adherlo</strong>.
</span>`}
    items={[
      {
        title: 'Softwareentwicklung',
        description:
          'Wir konzentrieren uns auf zuverlässige, sichere und benutzerzentrierte Lösungen, die echten Mehrwert liefern.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'Produktentwicklung',
        description:
          'Dank unserer interdisziplinären Expertise entwickeln wir HealthTech-Produkte vollständig in-house. Entdecken Sie <a href="https://www.adherlo.com" target="_blank" rel="noopener noreferrer" class="text-accent underline">Adherlo</a>.',
        icon: 'tabler:components',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Einblicke"
    title={`<span class="block xl:hidden">SETBASEs Blueprint</span><span class="hidden xl:block">SETBASE Blueprint: Einfachheit trifft Funktionalität</span>`}
    items={[
      {
        title: 'Modernste Technologien',
        description:
          'Wir nutzen die neuesten Software-Frameworks und zukunftsweisende Technologien, um skalierbare, kosteneffiziente und zukunftssichere Lösungen zu entwickeln.',
      },
      {
        title: 'Lean Management',
        description:
          'Unser schlanker Ansatz ermöglicht schnelle Entscheidungen, kurze Feedbackzyklen und ein kollaboratives Umfeld für effiziente Ergebnisse.',
      },
      {
        title: 'Kundenzentrierung',
        description:
          'Durch offene Kommunikation, Vertrauen und ein tiefes Verständnis der Herausforderungen schaffen wir Partnerschaften, die langfristigen Mehrwert und Zufriedenheit bringen.',
      },
    ]}
    image={{
      src: '~/assets/images/consulting.jpg',
      alt: 'AstroWind Hero Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Wie wir arbeiten</h3>
      Kontinuierliches Planen, Vereinfachen, Umsetzen und Evaluieren
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Kontaktiere uns',
        href: '/contact',
        target: '_blank',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      Kontaktieren Sie&nbsp;uns&nbsp;&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">jetzt!</span>
    </Fragment>

    <Fragment slot="subtitle">
      Zögern Sie nicht, unser Formular auszufüllen, uns eine E-Mail zu senden, anzurufen oder uns einfach über WhatsApp zu schreiben.
      Unkompliziert und unverbindlich, wir sind für Sie da.
    </Fragment>
  </CallToAction>
</Layout>
