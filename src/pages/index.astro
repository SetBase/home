---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'SETBASE — HealthTech made in Switzerland.',
  ignoreTitleTemplate: true,
};

const learnmore = "More"
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    actions={[
      {
      //variant: 'primary', text: 'Contact us', href: '/contact', icon: 'tabler:mail',
      variant: 'primary', text: 'Go to Adherlo', href: 'https://www.adherlo.com', icon: 'tabler:arrow-big-right',
      },
      //{ text: 'Learn more', href: '#Expertise' },
    ]}
    image={{ src: '~/assets/images/hero-image3.png', alt: 'AstroWind Hero Image' }}
  >
<Fragment slot="title">
  <!-- Mobile: only "HealthTech" -->
  <span class="inline sm:hidden">
    Health<span class="text-accent dark:text-white highlight">Tech</span>
  </span>

  <!-- Desktop: "We create HealthTech" -->
  <span class="hidden sm:inline">
    We create Health<span class="text-accent dark:text-white highlight">Tech</span>
  </span>
</Fragment>

    <Fragment slot="subtitle">
      <span >
       <!-- <span class="font-semibold">Digital Solutions</span> <br>Simple, uncomplicated, Siwss made. -->
       <br><br> Learn more about our newest project, <br>
       the innovative and comprehensive adherence solution:
       <br>
       <br>
        </span>
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <!-- Features Widget *************** -->

  <Features
    id="Expertise"
    tagline="The Startup"
    title="What we do"
    subtitle={`<span class="block xl:hidden">
  In the past, we successfully delivered HealthTech solutions for our clients. Today, we're fully focused on developing our own product: <strong>Adherlo</strong>.
</span>
`}
    items={[
      {
        title: 'Software engineering',
        description:
          'We focus on reliable, secure, and user-centric solutions delivering real value.',
        icon: 'tabler:brand-tailwind',
        // href: '/services/software',
        // mobileText: learnmore
      },
      {
        title: 'Product development',
        description:
          'Leveraging our interdisciplinary expertise, we develop HealthTech products entirely in-house. Explore <a href="https://www.adherlo.com" target="_blank" rel="noopener noreferrer" class="text-accent underline">Adherlo</a>.',
        icon: 'tabler:components',
        // href: '/services/product',
        //mobileText: learnmore
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Insights"
    title={`<span class="block xl:hidden">SETBASE's Blueprint</span><span class="hidden xl:block">SETBASE's Blueprint: Simplicity Meets Functionality</span>`}
    items={[
      {
        title: 'Cutting-Edge Technology',
        description:
          'We leverage the latest software frameworks and emerging technologies to build scalable, cost-effective, and future-ready solutions.',
      },
      {
        title: 'Lean Management',
        description:
          'Our lean approach enables fast decision-making, short feedback loops, and a collaborative environment that delivers results efficiently.',
      },
      {
        title: 'Customer-Centered Approach',
        description:
          'Through open communication, trust, and a deep understanding of your challenges, we build partnerships that drive long-term value and satisfaction.',
      },
    ]}
    image={{
      src: '~/assets/images/consulting.jpg',
      alt: 'AstroWind Hero Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">How we work</h3>
      Continous planning, simplifiying, creating and evaluating
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->


  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Contact us',
        href: '/contact',
        target: '_blank',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      Get in touch&nbsp;&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">with us!</span>
    </Fragment>

    <Fragment slot="subtitle">
      Don't hesitate to fill out our form, send us an email, call or simply message us on Whatsapp. 
    </Fragment>
  </CallToAction>
</Layout>
